OPENAI_API_KEY=sk-...
# Modelo usado pra detectar personagens automaticamente
AI_DETECT_MODEL=gpt-5.4-mini-2026-03-17
# Esforço de raciocínio na tradução: none (mais barato/rápido), low, medium, high
TRANSLATE_REASONING=none
# Pasta onde os áudios gerados ficam salvos
OUTPUT_DIR=./outputs
# Quantas requisições TTS em paralelo
TTS_CONCURRENCY=5
