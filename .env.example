OPENAI_API_KEY=sk-...
# Modelo usado pra detectar personagens automaticamente
AI_DETECT_MODEL=gpt-5.4-mini-2026-03-17
# Esforço de raciocínio na tradução: none (mais barato/rápido), low, medium, high
TRANSLATE_REASONING=none
# Pasta onde os áudios gerados ficam salvos
OUTPUT_DIR=./outputs
# Quantas requisições TTS em paralelo
TTS_CONCURRENCY=5

# ----- Login / sessão -----
# Admin padrão: admin / All0sAdm1n@ (semeado no 1º boot).
# Defina ADMIN_PASSWORD no Railway pra trocar a senha do admin com segurança;
# se definida, ela sempre sincroniza o admin a cada boot.
ADMIN_USER=admin
ADMIN_PASSWORD=All0sAdm1n@
# Chave de assinatura dos cookies de sessão. Se vazia, é gerada e salva no volume.
SECRET_KEY=
# Cookie só por HTTPS (1 em produção). Use 0 só pra testar em HTTP fora de localhost.
COOKIE_SECURE=1
